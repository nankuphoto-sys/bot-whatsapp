# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por defecto claude-opus-5-5)
# MODELO=
# Opcional: archivo con la información del negocio (por defecto negocio/demo.md, un salón ficticio)
# NEGOCIO=negocio/mi-negocio.md

# WhatsApp Business Cloud API (developers.facebook.com → tu app → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Configuración de la app → Básica → Clave secreta de la app (firma de los webhooks)
WHATSAPP_APP_SECRET=
# Cualquier texto; el mismo que pongas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=

# Opcional: número del asesor que recibe el aviso cuando el bot pasa la conversación (ej. 573001234567)
NUMERO_ASESOR=
# Opcional: URL de un webhook de Google Apps Script que agrega cada lead a una hoja
SHEETS_WEBHOOK_URL=
PUERTO=3000

# Opcional: webhook de Slack, Discord, Google Chat o n8n que recibe las alertas (sin ella, solo quedan en los logs)
ALERTAS_WEBHOOK_URL=
# Horas sin recibir ningún mensaje antes de avisar (0 la desactiva)
ALERTA_SILENCIO_HORAS=24
